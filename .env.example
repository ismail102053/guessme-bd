# ============================================================
# GuessMe BD — পরিবেশ ভেরিয়েবল (Environment variables)
# এই ফাইলটি কপি করে `.env` নাম দিন:  cp .env.example .env
# `.env` ফাইল কখনো Git-এ কমিট করবেন না।
# ============================================================

# --- সার্ভার ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ডিপ্লয়ের পর আপনার সাইটের পূর্ণ ঠিকানা (শেষে / ছাড়া)।
# Facebook শেয়ার প্রিভিউয়ের (og:url) জন্য জরুরি।
# লোকালে খালি রাখলে Host হেডার থেকে নেওয়া হবে।
PUBLIC_BASE_URL=http://localhost:3000

# --- ডাটাবেস ---
# DB_DRIVER=sqlite  → লোকাল ফাইলে SQLite (লোকাল ডেভেলপমেন্ট, VPS/ডিস্কসহ হোস্টিং)
# DB_DRIVER=turso   → Turso (libSQL) ক্লাউড ডাটাবেস (ফ্রি টায়ার, Render ইত্যাদির জন্য সুপারিশকৃত)
DB_DRIVER=sqlite

# sqlite ড্রাইভারের জন্য ফাইলের পথ
SQLITE_PATH=./data/guessme.db

# turso ড্রাইভারের জন্য (https://turso.tech এ ফ্রি অ্যাকাউন্টে পাওয়া যায়)
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJ...   (গোপন! কখনো প্রকাশ করবেন না)

# সার্ভার চালুর সময় স্বয়ংক্রিয়ভাবে মাইগ্রেশন চালাবে কি না (true/false)
AUTO_MIGRATE=true

# --- নিরাপত্তা ---
# ★ প্রোডাকশনে বাধ্যতামূলক। কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম গোপন মান।
# তৈরি করুন:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# এটি IP ঠিকানা হ্যাশ করতে ও টিকেট সই করতে ব্যবহৃত হয়।
APP_SECRET=

# রিভার্স প্রক্সির পেছনে (Render, Railway, Fly.io, Cloudflare) থাকলে প্রক্সির সংখ্যা দিন।
# সাধারণত Render/Railway/Fly = 1। সরাসরি ইন্টারনেটে থাকলে 0।
TRUST_PROXY_HOPS=0

# --- রেট লিমিট ও স্প্যাম সুরক্ষা (ডিফল্ট মান ঠিক আছে; দরকারে বদলান) ---
RATE_LIMIT_CREATE_PER_HOUR=10
RATE_LIMIT_ATTEMPT_PER_HOUR=40
RATE_LIMIT_READ_PER_MINUTE=180
RATE_LIMIT_OWNER_PER_MINUTE=60
RATE_LIMIT_AUTH_FAIL_PER_15MIN=20
# একটি আইপি (হ্যাশ) থেকে একটি কুইজে ঘণ্টায় সর্বোচ্চ কতবার খেলা যাবে
MAX_ATTEMPTS_PER_IP_PER_QUIZ_PER_HOUR=6
# একটি আইপি (হ্যাশ) থেকে ২৪ ঘণ্টায় সর্বোচ্চ কতটি কুইজ তৈরি
MAX_QUIZZES_PER_IP_PER_DAY=15
# একটি কুইজে মোট সর্বোচ্চ কতজন খেলতে পারবে
MAX_ATTEMPTS_PER_QUIZ=2000
# প্রতি প্রশ্নে সর্বনিম্ন কত মিলিসেকেন্ড সময় না লাগলে বট ধরা হবে (মোট সময় হিসাবে)
MIN_MS_PER_QUESTION=700

# --- লগিং ---
# LOG_LEVEL=info          (debug | info | warn | error)
# LOG_SILENT=false        (true দিলে কোনো লগ ছাপা হবে না — টেস্টে ব্যবহৃত)
